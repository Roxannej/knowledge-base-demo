# 复制本文件为 backend/.env 后填写真实值（切勿把真实 Key 写进本示例文件或提交到 git）
#
# ---------- 默认：DeepSeek（OpenAI 兼容）----------
# 在 https://platform.deepseek.com 申请 API Key；文档：https://api-docs.deepseek.com/
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 建议与 DEEPSEEK_API_KEY 同值，避免环境里已有空 OPENAI_API_KEY 时鉴权失败
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 常用：deepseek-chat（对话） / deepseek-reasoner（推理，更慢更贵）
OPENAI_MODEL=deepseek-chat
#
# 仅填写 DEEPSEEK_API_KEY、不写 OPENAI_BASE_URL 时，程序会自动使用 https://api.deepseek.com/v1
#
# ---------- 可选：仍用 OpenAI 官方 ----------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# ---------- 其它兼容网关 ----------
# OPENAI_BASE_URL=https://你的网关/v1
# OPENAI_API_KEY=网关发放的_key
# OPENAI_MODEL=网关文档中的模型 id
#
# 兼容别名（未设置 OPENAI_API_KEY 时依次尝试）：DEEPSEEK_API_KEY → CHATGPT_API_KEY → CHATGPT_KEY
# CHATGPT_API_KEY=

# 可选：强制使用纯 numpy 哈希向量（无语义质量）。不设时：已装 torch+sentence-transformers 用真实嵌入，否则自动哈希兜底。
# RAG_FORCE_HASH_EMBEDDINGS=1

# 可选：FAISS 索引目录（绝对路径或相对路径）。不设时默认 backend/data/indexes/default/
# RAG_FAISS_INDEX_DIR=/path/to/your/index_dir

# 流式 Markdown 输出模式（后端控制表格切分）
# raw:   原样 token 输出（延迟最低，表格最不稳定）
# line:  按完整行输出
# block: 表格按完整 block 输出并做标准化（推荐，默认）
# TABLE_STREAM_MODE=block
